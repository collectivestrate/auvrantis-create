# AI configuration (server-only)
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AUVRANTIS_AI_MODEL=gpt-6-astra

# Pay-per-token pricing. AI stays closed until both rates are set.
# USD per million tokens, from your provider's price list for the model above.
AI_PRICE_INPUT_PER_MTOK=
AI_PRICE_OUTPUT_PER_MTOK=
AI_MARKUP=4
AI_MIN_CHARGE_CREDITS=1
AI_SIGNUP_CREDITS=25

# Stripe (credit packs and Learning Center Pro)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Auvrantis Check integration
NEXT_PUBLIC_AUVRANTIS_CHECK_URL=https://auvrantis-check.vercel.app

# Vercel Analytics (optional)
NEXT_PUBLIC_AUVRANTIS_ANALYTICS=true

# Beta publishing (optional)
AUVRANTIS_BETA_PUBLISH=true

# AI daily request limit (best effort)
AI_DAILY_LIMIT=50